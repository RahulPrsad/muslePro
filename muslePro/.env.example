# Copy this file to ".env" and fill in your own values.
# Only variables prefixed with VITE_ are exposed to the frontend code.

# Store identity
VITE_SITE_NAME="IronFuel"
VITE_TAGLINE="Fuel the rep that matters"

# Contact / socials shown in the footer
VITE_CONTACT_EMAIL="hello@ironfuel.example"
VITE_CONTACT_PHONE="+91 90000 00000"
VITE_WHATSAPP_NUMBER="919000000000"
VITE_INSTAGRAM_URL="https://instagram.com/ironfuel"

# Store settings
VITE_CURRENCY_SYMBOL="₹"
VITE_FREE_SHIPPING_THRESHOLD="1999"


# --- Ethereum / MetaMask checkout ---
# Wallet address that receives test payments. Use YOUR OWN address to test.
VITE_STORE_WALLET_ADDRESS=""

# Network to require in MetaMask. Defaults to Sepolia testnet (chainId 11155111).
# Sepolia hex chainId is 0xaa36a7. Switch to "0x1" for Ethereum mainnet (real funds!).
VITE_CHAIN_ID_HEX="0xaa36a7"
VITE_CHAIN_NAME="Sepolia Test Network"
VITE_CHAIN_RPC_URL="https://rpc.sepolia.org"
VITE_CHAIN_EXPLORER_URL="https://sepolia.etherscan.io"
VITE_CHAIN_CURRENCY_SYMBOL="SepoliaETH"

# Flat ETH amount charged for the demo "Shop Now" checkout button
VITE_CHECKOUT_AMOUNT_ETH="0.0001"
